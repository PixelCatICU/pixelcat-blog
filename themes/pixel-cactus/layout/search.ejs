<%
  var searchLocale = page.lang || config.language || 'zh-CN';
  var searchText = searchLocale === 'ru' ? {
    title: 'Поиск', placeholder: 'Введите ключевое слово', loading: 'Загрузка поискового индекса...',
    start: 'Введите ключевое слово для поиска.', empty: 'Статьи не найдены.', found: 'Найдено статей: ', failed: 'Не удалось загрузить поисковый индекс.'
  } : (searchLocale === 'fa' ? {
    title: 'جستجو', placeholder: 'کلیدواژه را وارد کنید', loading: 'در حال بارگذاری فهرست جستجو...',
    start: 'برای جستجو یک کلیدواژه وارد کنید.', empty: 'نوشته‌ای پیدا نشد.', found: 'تعداد نوشته‌های پیدا شده: ', failed: 'بارگذاری فهرست جستجو ناموفق بود.'
  } : {
    title: '搜索', placeholder: '输入关键词', loading: '正在加载搜索索引...',
    start: '输入关键词开始搜索。', empty: '没有找到相关文章。', found: '找到文章：', failed: '搜索索引加载失败，请刷新页面重试。'
  });
%>
<section class="section">
  <h1><%= searchText.title %></h1>
  <div class="search-box">
    <input id="search-input" type="search" placeholder="<%= searchText.placeholder %>" autocomplete="off">
  </div>
  <p id="search-status" class="search-status"><%= searchText.loading %></p>
  <ul id="search-results" class="post-list"></ul>
</section>
<script>
  (() => {
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const status = document.getElementById('search-status');
    let entries = [];
    let loaded = false;
    const labels = <%- JSON.stringify(searchText) %>;
    const locale = <%- JSON.stringify(searchLocale) %>;

    const getText = (node, selector) => {
      const target = node.querySelector(selector);
      return target ? target.textContent.trim() : '';
    };

    const stripHtml = (html) => {
      const div = document.createElement('div');
      div.innerHTML = html;
      return div.textContent || div.innerText || '';
    };

    const render = () => {
      const keyword = input.value.trim().toLowerCase();
      results.innerHTML = '';

      if (!loaded) {
        status.textContent = labels.loading;
        return;
      }

      if (!keyword) {
        status.textContent = labels.start;
        return;
      }

      const matched = entries
        .filter((entry) => entry.searchText.includes(keyword))
        .slice(0, 20);

      if (!matched.length) {
        status.textContent = labels.empty;
        return;
      }

      status.textContent = `${labels.found}${matched.length}`;
      matched.forEach((entry) => {
        const li = document.createElement('li');
        const time = document.createElement('time');
        const a = document.createElement('a');
        time.textContent = entry.tags;
        a.href = entry.url;
        a.textContent = entry.title;
        li.appendChild(time);
        li.appendChild(a);
        results.appendChild(li);
      });
    };

    input.addEventListener('input', render);

    fetch('<%- url_for("/search.xml") %>', { cache: 'no-store' })
      .then((response) => {
        if (!response.ok) throw new Error('Search index request failed');
        return response.text();
      })
      .then((xmlText) => {
        const xml = new DOMParser().parseFromString(xmlText, 'text/xml');
        entries = Array.from(xml.querySelectorAll('entry')).map((entry) => {
          const tags = Array.from(entry.querySelectorAll('tag'))
            .map((tag) => tag.textContent.trim())
            .filter(Boolean)
            .join(' / ');
          const title = getText(entry, 'title');
          const url = getText(entry, 'url') || entry.querySelector('link')?.getAttribute('href') || '#';
          const content = stripHtml(getText(entry, 'content'));
          const entryLang = entry.getAttribute('lang') || '';
          return {
            title,
            url,
            tags,
            lang: entryLang,
            searchText: `${title} ${tags} ${content}`.toLowerCase()
          };
        }).filter((entry) => !entry.lang || entry.lang === locale);
        loaded = true;
        render();
      })
      .catch(() => {
        loaded = true;
        entries = [];
        status.textContent = labels.failed;
      });
  })();
</script>
