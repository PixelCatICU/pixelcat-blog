<%
  var locale = page.lang || config.language || 'zh-CN';
  var dict = (site.data.i18n && site.data.i18n[locale]) || site.data.i18n['zh-CN'];
  var localeRoot = locale === 'zh-CN' ? '/' : '/' + locale + '/';
  var localizedBrand = locale === 'ru' ? 'PixelCat ICU — сетевые руководства' : (locale === 'fa' ? 'PixelCat ICU — آموزش شبکه' : config.title);
  var translations = page.translations || {
    'zh-CN': '/',
    'ru': '/ru/',
    'fa': '/fa/'
  };
%>
<header class="site-header">
  <a class="brand" href="<%- url_for(localeRoot) %>" aria-label="<%= config.title %>">
    <img src="<%- url_for(theme.profile.avatar) %>" alt="" class="brand-mark">
    <span class="brand-text"><%= localizedBrand %></span>
  </a>
  <div class="header-actions">
    <nav class="site-nav" aria-label="Navigation">
      <a href="<%- url_for(localeRoot) %>"><%= dict.home %></a>
      <% if (locale === 'zh-CN') { %>
        <a href="<%- url_for('/archives/') %>"><%= dict.archives %></a>
        <a href="<%- url_for('/tags/') %>"><%= dict.tags %></a>
      <% } %>
      <a href="<%- url_for(localeRoot + 'search/') %>"><%= dict.search %></a>
      <a href="<%- url_for(localeRoot + 'about/') %>"><%= dict.about %></a>
    </nav>
    <div class="display-controls">
      <label class="language-select-wrap">
        <span class="visually-hidden"><%= dict.language %></span>
        <select class="language-select" data-language-select aria-label="<%= dict.language %>">
          <option value="<%- url_for(translations['zh-CN'] || '/') %>" data-lang="zh-CN" <%= locale === 'zh-CN' ? 'selected' : '' %>>中文</option>
          <option value="<%- url_for(translations.ru || '/ru/') %>" data-lang="ru" <%= locale === 'ru' ? 'selected' : '' %>>Русский</option>
          <option value="<%- url_for(translations.fa || '/fa/') %>" data-lang="fa" <%= locale === 'fa' ? 'selected' : '' %>>فارسی</option>
        </select>
      </label>
      <button class="theme-toggle" type="button" data-theme-toggle>Light</button>
    </div>
  </div>
</header>
